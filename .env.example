# Optional production services. The local MVP needs none of these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000/api/v1

# Email delivery for signup verification. Without SMTP_HOST, verification codes
# are printed to the backend console for local development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=
SMTP_FROM=CampusFlow AI <no-reply@campusflow.edu>
SMTP_TLS=true
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
CAMPUSFLOW_SECRET=replace-with-a-long-random-production-secret
